{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crm-libertario",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/_next/static/*", "!/*/_next/static/*", "!/favicon.png", "!/apple-touch-icon.png", "!/icons/*", "!/brand/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crm-pay-line",
      "database_id": "ded1c012-2e0a-4b1b-9339-24047b32a99e",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "LEGAL_FILES",
      "bucket_name": "crm-legal-files"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  // Secrets are set in the dashboard or with `wrangler secret put`. Do not commit values.
  // GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET (already set), TOKEN_ENC_KEY (required before Gmail connect),
  // MAIL_TEST_MODE (optional; unset means test mode, "false" sends to the real recipient).
  "vars": {
    "MAIL_MODE": "gmail_api",
    "MAIL_FROM_ADDRESS": "lidertransformacion@libertariocoffee.com",
    "MAIL_FROM_NAME": "Comercial Libertario",
    "SHEETS_SYNC_ENABLED": "false",
    "GOOGLE_SHEETS_SPREADSHEET_ID": "1mrb-s2PbDOEvNwdAs2zMyT7czMxx1tqcYGuwk4FQks4",
    "GOOGLE_SHEETS_TAB": "Listado Equipos",
    "BOOTSTRAP_ADMIN_EMAIL": "lidertransformacion@libertariocoffee.com"
  }
}
