# Google Sheets sync ships off. Leave this unset or any value other than true.
# The app then shows a dry-run diff and never calls Google.
SHEETS_SYNC_ENABLED=false

# Required only after sync is explicitly enabled. Never commit real values.
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB=Listado Equipos

# Optional override for the local SQLite file. Default: data/crm.sqlite
CRM_DB_PATH=
