# Required to sign the session cookie. At least 16 characters. Never commit a real value.
SESSION_SECRET=

# First admin: lidertransformacion@libertariocoffee.com
# Inserted only when that user is missing. Minimum 12 characters.
# Changing it later does not rotate the password. Use npm run reset-password.
# The account must change this password before using the CRM.
BOOTSTRAP_ADMIN_PASSWORD=

# Optional local SQLite path. Default: data/crm.sqlite
# Cloudflare uses the D1 binding DB instead.
CRM_DB_PATH=

# log only queues. gmail_api sends through Gmail. smtp is Node-only.
MAIL_MODE=log
MAIL_FROM_ADDRESS=lidertransformacion@libertariocoffee.com
MAIL_FROM_NAME=Comercial Libertario
# JSON: client_id, client_secret, refresh_token. Fallback sender when a user has no connected Gmail.
GMAIL_TOKEN_JSON=

# Per-user Gmail OAuth. Read from the Worker env. Never commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# AES-GCM key for refresh tokens. `openssl rand -base64 32`. At least 16 characters.
TOKEN_ENC_KEY=
# Optional. Production redirect is https://crm-libertario.libertario.workers.dev/api/auth/google/callback
GOOGLE_REDIRECT_URI=
# Unset or anything other than false keeps test mode (customers do not receive mail).
MAIL_TEST_MODE=

# Google Sheets sync stays off until this is exactly true.
SHEETS_SYNC_ENABLED=false
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=1mrb-s2PbDOEvNwdAs2zMyT7czMxx1tqcYGuwk4FQks4
GOOGLE_SHEETS_TAB=Listado Equipos

# Bearer token for the browser agent. Minimum 16 characters. The CRM never calls Odoo.
ODOO_AGENT_TOKEN=
